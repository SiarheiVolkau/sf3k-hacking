					reg = <0x18800560 0x30>;
				};
			};

			functions {

				pctl_sf {
					groups = "GPIO_T_14", "GPIO_T_15", "GPIO_T_16", "GPIO_T_17", "GPIO_T_18", "GPIO_T_19";
					field-value-0 = <0x01>;
					field-value-1 = <0x01>;
					field-value-2 = <0x01>;
					field-value-3 = <0x01>;
					field-value-4 = <0x01>;
					field-value-5 = <0x01>;
					linux,phandle = <0x0d>;
					phandle = <0x0d>;
				};

				pctl_spim {
					groups = "GPIO_B_12", "GPIO_B_13", "GPIO_B_15", "GPIO_B_16", "GPIO_B_17";
					field-value-0 = <0x0a>;
					field-value-1 = <0x0a>;
					field-value-2 = <0x0a>;
					field-value-3 = <0x0a>;
					field-value-4 = <0x00>;
				};

				pctl_irc {
					groups = "GPIO_L_14";
					field-value-0 = <0x01>;
					linux,phandle = <0x10>;
					phandle = <0x10>;
				};

				pctl_sdio {
					groups = "GPIO_T_00", "GPIO_T_01", "GPIO_T_02", "GPIO_T_03", "GPIO_T_04", "GPIO_T_05";
					field-value-0 = <0xf9>;
					field-value-1 = <0xf9>;
					field-value-2 = <0xf9>;
					field-value-3 = <0xf9>;
					field-value-4 = <0xf9>;
					field-value-5 = <0xf9>;
					field-value-6 = <0xf9>;
					linux,phandle = <0x0f>;
					phandle = <0x0f>;
				};

				pctl_i2c0 {
					groups = "GPIO_L_12", "GPIO_L_13";
					field-value-0 = <0x05>;
					field-value-1 = <0x05>;
				};
			};
		};

